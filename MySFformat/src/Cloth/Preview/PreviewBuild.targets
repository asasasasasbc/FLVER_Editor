<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="BuildClothPreviewHelpers" AfterTargets="Build" Condition="'$(BuildClothPreviewHelpers)' != 'false'">
    <PropertyGroup>
      <PreviewSource>$(MSBuildProjectDirectory)\src\Cloth\Preview\</PreviewSource>
      <PreviewObj>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)ClothPreview\</PreviewObj>
      <PreviewOut>$(TargetDir)tools\ClothPreview\</PreviewOut>
      <PreviewCompiler>$(MSBuildBinPath)\Roslyn\csc.exe</PreviewCompiler>
    </PropertyGroup>
    <MakeDir Directories="$(PreviewObj);$(PreviewOut)" />
    <Exec Command="&quot;$(PreviewCompiler)&quot; /nologo /r:System.Xml.Linq.dll /out:&quot;$(PreviewObj)SchemaGenerator.exe&quot; &quot;$(PreviewSource)PreviewSchemaGenerator.cs&quot;" />
    <Exec Command="&quot;$(PreviewObj)SchemaGenerator.exe&quot; &quot;$(MSBuildProjectDirectory)\tools\Cloth\native-schema.xml&quot; &quot;$(PreviewObj)schema-bb.xml&quot; &quot;$(MSBuildProjectDirectory)\tools\Cloth\native-schema-ds3.xml&quot; &quot;$(PreviewObj)schema-ds3.xml&quot;" />
    <Exec Command="&quot;$(PreviewCompiler)&quot; /nologo /platform:x64 /unsafe /optimize+ /win32manifest:&quot;$(PreviewSource)host.manifest&quot; /r:System.Windows.Forms.dll /r:System.Drawing.dll /r:System.Numerics.dll /r:System.Web.Extensions.dll /out:&quot;$(PreviewOut)HctPreviewProbe.exe&quot; &quot;$(PreviewSource)HctPreviewProbe.cs&quot; &quot;$(PreviewSource)HostNetworkGuard.cs&quot; &quot;$(PreviewSource)NativeSimulation.cs&quot; &quot;$(PreviewSource)PreviewData.cs&quot; &quot;$(PreviewSource)PreviewEnvironment.cs&quot; &quot;$(PreviewSource)HostEnvironment.cs&quot;" />
    <Exec Command="&quot;$(PreviewCompiler)&quot; /nologo /platform:x64 /optimize+ /win32manifest:&quot;$(PreviewSource)host.manifest&quot; /r:System.Xml.Linq.dll /r:System.Numerics.dll /r:System.Web.Extensions.dll /r:&quot;$(TargetDir)SoulsFormats.dll&quot; /resource:&quot;$(PreviewObj)schema-bb.xml&quot;,MySFformat.NativeClothSchema.xml /resource:&quot;$(PreviewObj)schema-ds3.xml&quot;,MySFformat.NativeDs3ClothSchema.xml /out:&quot;$(PreviewOut)PreviewAssetBuilder.exe&quot; &quot;$(PreviewSource)PreviewAssetBuilder.cs&quot; &quot;$(PreviewSource)PreviewData.cs&quot; &quot;$(PreviewSource)PreviewEnvironment.cs&quot; &quot;$(MSBuildProjectDirectory)\src\HkxPack\HkxPackfileCodec.cs&quot;" />
    <ItemGroup><PreviewDependency Include="$(TargetDir)SoulsFormats.dll;$(TargetDir)System*.dll" /></ItemGroup>
    <Copy SourceFiles="@(PreviewDependency)" DestinationFolder="$(PreviewOut)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath).config" DestinationFiles="$(PreviewOut)PreviewAssetBuilder.exe.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PreviewSource)Host.config" DestinationFiles="$(PreviewOut)HctPreviewProbe.exe.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PreviewObj)schema-bb.xml;$(PreviewSource)README.md" DestinationFolder="$(PreviewOut)" SkipUnchangedFiles="true" />
  </Target>
</Project>
